# ==========================================
# .gitignore para Odoo / OpenEduCat (Brasil)
# ==========================================

# Arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Arquivos de log e debug
*.log
*.pot

# Pastas de dados locais do Docker (NUNCA comitar)
pg_data/
odoo_data/
filestore/
sessions/

# Ambientes Virtuais e Variáveis de Ambiente
venv/
.venv/
env/
.env

# Ferramentas de IA / Assistentes
.gemini/
.agents/

# Documentos Institucionais em PDF (Regulamentos e Páginas Locais)
*.pdf
docs/exemplos_referencia/pdfs/

# Arquivos de IDE e SO
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
docs/.Rhistory

# Ignora dependências externas baixadas via script
openeducat_erp/
external_addons/


