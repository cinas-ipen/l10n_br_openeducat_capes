<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.admission.edital                          -->
        <!-- =============================================================== -->
        <record id="rule_op_admission_edital_admin" model="ir.rule">
            <field name="name">Editais de Admissão: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_admission_edital"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_op_admission_edital_coord_sec" model="ir.rule">
            <field name="name">Editais de Admissão: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_op_admission_edital"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.student.work_plan                         -->
        <!-- =============================================================== -->
        <record id="rule_op_student_work_plan_portal" model="ir.rule">
            <field name="name">Plano de Trabalho: Discente Autor (Portal)</field>
            <field name="model_id" ref="model_op_student_work_plan"/>
            <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_op_student_work_plan_admin" model="ir.rule">
            <field name="name">Plano de Trabalho: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_student_work_plan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_op_student_work_plan_coord_sec" model="ir.rule">
            <field name="name">Plano de Trabalho: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_op_student_work_plan"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <record id="rule_op_student_work_plan_faculty" model="ir.rule">
            <field name="name">Plano de Trabalho: Orientador</field>
            <field name="model_id" ref="model_op_student_work_plan"/>
            <field name="domain_force">['|', ('advisor_id.partner_id', '=', user.partner_id.id), ('student_id.advisor_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
