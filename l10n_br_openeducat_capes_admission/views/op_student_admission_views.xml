<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_admission_360" model="ir.ui.view">
        <field name="name">op.student.form.admission.360</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button de Planos de Trabalho -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_work_plans" type="object" class="oe_stat_button" icon="fa-tasks">
                    <field name="work_plan_count" widget="statinfo" string="Planos Trab."/>
                </button>
            </xpath>

            <!-- Aba de Planos de Trabalho Discente -->
            <xpath expr="//notebook" position="inside">
                <page string="Planos de Trabalho" name="work_plans_page">
                    <field name="work_plan_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="research_line"/>
                            <field name="advisor_id"/>
                            <field name="opinion_category"/>
                            <field name="cep_approved"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
