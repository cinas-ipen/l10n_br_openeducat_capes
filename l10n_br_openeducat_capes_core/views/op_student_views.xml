<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_capes" model="ir.ui.view">
        <field name="name">op.student.form.capes</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <!-- Smart Buttons no Topo da Ficha do Aluno -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_courses" type="object" class="oe_stat_button" icon="fa-university">
                    <field name="course_count" widget="statinfo" string="Vínculos"/>
                </button>
            </xpath>

            <!-- Páginas do Caderno Acadêmico -->
            <xpath expr="//notebook" position="inside">
                <page string="Vínculo Regimental e Proficiências" name="capes_student_info">
                    <group>
                        <group string="Vínculo Acadêmico e Regimento (Ato Perfeito)">
                            <field name="ra_number" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="student_category"/>
                            <field name="capes_status"/>
                            <field name="admission_date"/>
                            <field name="status_date"/>
                        </group>
                        <group string="Orientação Acadêmica">
                            <field name="advisor_id"/>
                            <field name="coadvisor_id"/>
                        </group>
                    </group>
                    <group string="Controle de Proficiência Linguística">
                        <group>
                            <field name="english_proficiency_status"/>
                        </group>
                        <group>
                            <field name="portuguese_proficiency_status"/>
                        </group>
                    </group>
                </page>

                <page string="Dados Censitários CAPES / DAV" name="capes_census_info">
                    <group>
                        <group string="Identificação e Censo Demográfico">
                            <field name="cpf"/>
                            <field name="mother_name"/>
                            <field name="race_color"/>
                            <field name="has_disability"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="nationality"/>
                        </group>
                        <group string="Naturalidade e Origem">
                            <field name="birth_city_name"/>
                            <field name="birth_state"/>
                            <field name="birth_country_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Identificadores Digitais Persistentes (PIDs)">
                            <field name="orcid" widget="url" placeholder="0000-0000-0000-0000"/>
                            <field name="lattes_url" widget="url" placeholder="http://lattes.cnpq.br/..."/>
                        </group>
                        <group string="Formação Prévia">
                            <field name="highest_degree"/>
                            <field name="academic_level"/>
                        </group>
                    </group>
                    <group string="Endereço Residencial e Contato Oficial">
                        <group>
                            <label for="street" string="Logradouro / Número"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Rua, Av., Número..." class="o_address_street"/>
                                <field name="street2" placeholder="Complemento, Apto, Bloco..." class="o_address_street"/>
                                <field name="city" placeholder="Cidade" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="Estado" options="{'no_open': True}"/>
                                <field name="zip" placeholder="CEP" class="o_address_zip"/>
                                <field name="country_id" placeholder="País" class="o_address_country" options="{'no_open': True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
