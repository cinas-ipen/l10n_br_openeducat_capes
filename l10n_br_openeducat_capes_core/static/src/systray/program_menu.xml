<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_br_openeducat_capes_core.ProgramMenu">
        <div t-if="currentProgram" class="o_capes_program_menu d-flex align-items-center me-2">
            <!-- Caso 1: Multiprograma ou Administrador Central (Dropdown Interativo) -->
            <t t-if="isMultiProgram">
                <Dropdown position="'bottom-end'" menuClass="'dropdown-menu-end'">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center" type="button">
                        <i class="fa fa-graduation-cap me-1"/>
                        <span class="fw-bold" t-esc="currentProgram.short_name || currentProgram.name"/>
                    </button>
                    <t t-set-slot="content">
                        <div class="dropdown-header small text-uppercase text-muted">
                            Programas de Pós-Graduação
                        </div>
                        <t t-foreach="allowedPrograms" t-as="prog" t-key="prog.id">
                            <DropdownItem onSelected="() => this.switchProgram(prog.id)"
                                          class="{ 'active fw-bold': prog.id === currentProgram.id }">
                                <i t-if="prog.id === currentProgram.id" class="fa fa-check me-2 text-primary"/>
                                <i t-else="" class="fa fa-circle-o me-2 text-muted"/>
                                <span t-esc="prog.name"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </t>

            <!-- Caso 2: Programa Único / Monoprograma (ex: MPTRCS - Informativo e Sem Atrito) -->
            <t t-else="">
                <span class="badge bg-light text-dark border d-flex align-items-center py-2 px-3" title="Programa Ativo">
                    <i class="fa fa-graduation-cap me-1 text-primary"/>
                    <span class="fw-bold" t-esc="currentProgram.short_name || currentProgram.name"/>
                </span>
            </t>
        </div>
    </t>
</templates>
