<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo: Secretaria de Pós-Graduação -->
        <record id="group_capes_program_secretary" model="res.groups">
            <field name="name">Secretaria de Programa</field>
            <field name="privilege_id" ref="openeducat_core.module_category_openeducat"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="comment">Operação cotidiana de matrículas, turmas, requerimentos e cadastros do programa.</field>
        </record>

        <!-- Grupo: Coordenação de Pós-Graduação -->
        <record id="group_capes_program_coordinator" model="res.groups">
            <field name="name">Coordenação de Programa</field>
            <field name="privilege_id" ref="openeducat_core.module_category_openeducat"/>
            <field name="implied_ids" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="comment">Gestão acadêmica e colegiada da CPG estrita ao seu programa de pós-graduação.</field>
        </record>

        <!-- Grupo: Administrador Central (Pró-Reitoria) -->
        <record id="group_capes_central_admin" model="res.groups">
            <field name="name">Administrador Central (Pró-Reitoria)</field>
            <field name="privilege_id" ref="openeducat_core.module_category_openeducat"/>
            <field name="implied_ids" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Supervisão global de todos os programas, relatórios integrados e auditoria institucional.</field>
        </record>
    </data>
</odoo>
