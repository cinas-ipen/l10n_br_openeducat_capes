<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.program.capes                             -->
        <!-- =============================================================== -->
        <record id="rule_op_program_capes_central_admin" model="ir.rule">
            <field name="name">Programas CAPES: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_program_capes"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_capes_central_admin'))]"/>
        </record>

        <record id="rule_op_program_capes_coordinator_secretary" model="ir.rule">
            <field name="name">Programas CAPES: Coordenação e Secretaria (Autorizados)</field>
            <field name="model_id" ref="model_op_program_capes"/>
            <field name="domain_force">[('id', 'in', user.allowed_program_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_capes_program_secretary')), (4, ref('group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.program.concentration.area               -->
        <!-- =============================================================== -->
        <record id="rule_op_program_concentration_area_central_admin" model="ir.rule">
            <field name="name">Áreas de Concentração: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_program_concentration_area"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_capes_central_admin'))]"/>
        </record>

        <record id="rule_op_program_concentration_area_coordinator_secretary" model="ir.rule">
            <field name="name">Áreas de Concentração: Coordenação e Secretaria por Programa</field>
            <field name="model_id" ref="model_op_program_concentration_area"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_capes_program_secretary')), (4, ref('group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.program.research.line                    -->
        <!-- =============================================================== -->
        <record id="rule_op_program_research_line_central_admin" model="ir.rule">
            <field name="name">Linhas de Pesquisa: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_program_research_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_capes_central_admin'))]"/>
        </record>

        <record id="rule_op_program_research_line_coordinator_secretary" model="ir.rule">
            <field name="name">Linhas de Pesquisa: Coordenação e Secretaria por Programa</field>
            <field name="model_id" ref="model_op_program_research_line"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_capes_program_secretary')), (4, ref('group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: op.student (Base / Portal / Global)          -->
        <!-- =============================================================== -->
        <record id="rule_op_student_portal" model="ir.rule">
            <field name="name">Discente: Acesso Exclusivo aos Próprios Dados (Portal)</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_op_student_central_admin" model="ir.rule">
            <field name="name">Discentes: Administrador Central (Global)</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_capes_central_admin'))]"/>
        </record>
    </data>
</odoo>
