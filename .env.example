# ==============================================================================
# Configurações de Ambiente - l10n_br_openeducat_capes
# Copie este arquivo para .env e ajuste as variáveis para o seu ambiente.
# ==============================================================================

# Host de Ligação da Aplicação 
# Use 127.0.0.1 para acesso estritamente local ou 0.0.0.0 para IP público / rede interna
BIND_HOST=127.0.0.1

# Portas HTTP e Longpolling do Odoo
ODOO_PORT=8069
LONGPOLLING_PORT=8072

# Credenciais do Banco de Dados PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=altere_para_uma_senha_postgres_segura
DB_HOST=db
DB_PORT=5432

# Master Password do Odoo (Utilizada para criar, duplicar ou restaurar bases de dados)
ODOO_ADMIN_PASSWD=altere_para_uma_master_password_segura

# Nome do Projeto Docker Compose
COMPOSE_PROJECT_NAME=openeducat_capes
