<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.scholarship.quota                      -->
        <!-- =============================================================== -->
        <record id="rule_scholarship_quota_admin" model="ir.rule">
            <field name="name">Cotas de Bolsas: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_scholarship_quota"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_scholarship_quota_coord_sec" model="ir.rule">
            <field name="name">Cotas de Bolsas: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_capes_scholarship_quota"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.scholarship.edital                     -->
        <!-- =============================================================== -->
        <record id="rule_scholarship_edital_admin" model="ir.rule">
            <field name="name">Editais de Bolsas: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_scholarship_edital"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_scholarship_edital_coord_sec" model="ir.rule">
            <field name="name">Editais de Bolsas: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_capes_scholarship_edital"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.scholarship.application                -->
        <!-- =============================================================== -->
        <record id="rule_scholarship_application_portal" model="ir.rule">
            <field name="name">Inscrição de Bolsa: Discente Candidato (Portal)</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_scholarship_application_admin" model="ir.rule">
            <field name="name">Inscrições de Bolsas: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_scholarship_application_coord_sec" model="ir.rule">
            <field name="name">Inscrições de Bolsas: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <record id="rule_scholarship_application_faculty" model="ir.rule">
            <field name="name">Inscrições de Bolsas: Revisores Pareceristas e Orientadores</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">['|', '|', ('reviewer1_id.partner_id', '=', user.partner_id.id), ('reviewer2_id.partner_id', '=', user.partner_id.id), ('faculty_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.scholarship.assignment                 -->
        <!-- =============================================================== -->
        <record id="rule_scholarship_assignment_portal" model="ir.rule">
            <field name="name">Concessão de Bolsa: Discente Bolsista (Portal)</field>
            <field name="model_id" ref="model_capes_scholarship_assignment"/>
            <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_scholarship_assignment_admin" model="ir.rule">
            <field name="name">Concessão de Bolsas: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_scholarship_assignment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_scholarship_assignment_coord_sec" model="ir.rule">
            <field name="name">Concessão de Bolsas: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_capes_scholarship_assignment"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>
    </data>
</odoo>
