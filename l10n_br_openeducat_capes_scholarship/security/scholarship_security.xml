<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- REGRAS DE REGISTRO (RECORD RULES): DISCENTE / CANDIDATO     -->
        <!-- ============================================================ -->

        <record id="rule_scholarship_application_student" model="ir.rule">
            <field name="name">Discente: Apenas Próprias Candidaturas a Bolsa</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_scholarship_evaluation_student" model="ir.rule">
            <field name="name">Discente: Apenas Própria Autoavaliação de Bolsa</field>
            <field name="model_id" ref="model_capes_scholarship_evaluation"/>
            <field name="domain_force">[('evaluator_role', '=', 'candidate_self'), ('application_id.student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_scholarship_assignment_student" model="ir.rule">
            <field name="name">Discente: Apenas Próprias Concessões de Bolsa</field>
            <field name="model_id" ref="model_capes_scholarship_assignment"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- REGRAS DE REGISTRO (RECORD RULES): DOCENTE / REVISOR         -->
        <!-- ============================================================ -->

        <record id="rule_scholarship_evaluation_faculty" model="ir.rule">
            <field name="name">Docente: Avaliações Designadas para Julgamento</field>
            <field name="model_id" ref="model_capes_scholarship_evaluation"/>
            <field name="domain_force">['|', ('evaluator_id.user_id', '=', user.id), ('application_id.faculty_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_scholarship_application_faculty" model="ir.rule">
            <field name="name">Docente: Candidaturas Designadas ou sob Orientação</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">['|', '|', ('reviewer1_id.user_id', '=', user.id), ('reviewer2_id.user_id', '=', user.id), ('faculty_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================================ -->
        <!-- REGRAS DE REGISTRO: SECRETARIA / GESTOR (ACESSO TOTAL)       -->
        <!-- ============================================================ -->

        <record id="rule_scholarship_application_admin" model="ir.rule">
            <field name="name">Secretaria/Gestor: Gestão Plena de Candidaturas</field>
            <field name="model_id" ref="model_capes_scholarship_application"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_scholarship_evaluation_admin" model="ir.rule">
            <field name="name">Secretaria/Gestor: Gestão Plena de Avaliações</field>
            <field name="model_id" ref="model_capes_scholarship_evaluation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_scholarship_assignment_admin" model="ir.rule">
            <field name="name">Secretaria/Gestor: Gestão Plena de Concessões</field>
            <field name="model_id" ref="model_capes_scholarship_assignment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
