<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_ptt_360" model="ir.ui.view">
        <field name="name">op.student.form.ptt.360</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button de Produtos Técnicos e Tecnológicos -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ptts" type="object" class="oe_stat_button" icon="fa-cogs">
                    <field name="ptt_count" widget="statinfo" string="Produtos PTT"/>
                </button>
            </xpath>

            <!-- Aba de Produção Técnica e Tecnológica -->
            <xpath expr="//notebook" position="inside">
                <page string="Produção Técnica (PTT)" name="ptts_page">
                    <field name="ptt_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="type_id"/>
                            <field name="axis_id"/>
                            <field name="trl_level"/>
                            <field name="is_adherent"/>
                            <field name="state"/>
                            <field name="repository_url" widget="url"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
