<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PTT Product Tree View -->
    <record id="view_capes_ptt_product_tree" model="ir.ui.view">
        <field name="name">capes.ptt.product.tree</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <list string="Produtos Técnico-Tecnológicos (PTT)">
                <field name="title"/>
                <field name="type_id"/>
                <field name="axis_id"/>
                <field name="student_id"/>
                <field name="trl_level"/>
                <field name="is_adherent" widget="boolean_toggle"/>
                <field name="final_stratum" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- PTT Product Kanban View -->
    <record id="view_capes_ptt_product_kanban" model="ir.ui.view">
        <field name="name">capes.ptt.product.kanban</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="title"/>
                <field name="student_id"/>
                <field name="type_id"/>
                <field name="final_stratum"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click card p-2 mb-2 shadow-sm">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="title"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span><field name="student_id"/></span><br/>
                                <span class="badge bg-info text-white"><field name="type_id"/></span>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-primary"><field name="final_stratum"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- PTT Product Pivot View (TRL x Tipologia) -->
    <record id="view_capes_ptt_product_pivot" model="ir.ui.view">
        <field name="name">capes.ptt.product.pivot</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <pivot string="Matriz de Produção PTT (TRL x Tipologia)">
                <field name="type_id" type="row"/>
                <field name="trl_level" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- PTT Product Graph View (Distribuição de Estratos) -->
    <record id="view_capes_ptt_product_graph" model="ir.ui.view">
        <field name="name">capes.ptt.product.graph</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <graph string="Distribuição de Estratos do Qualis Tecnológico" type="pie">
                <field name="final_stratum"/>
            </graph>
        </field>
    </record>

    <!-- PTT Product Form View -->
    <record id="view_capes_ptt_product_form" model="ir.ui.view">
        <field name="name">capes.ptt.product.form</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <form string="Produto Técnico-Tecnológico (PTT)">
                <header>
                    <button name="action_submit_for_evaluation" string="Enviar para Avaliação" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_homologate_ptt" string="Homologar PTT" type="object" class="oe_highlight" invisible="state not in ('evaluating', 'adherence_check')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,adherence_check,evaluating,homologated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title" string="Título do Produto Técnico-Tecnológico"/>
                        <h1><field name="title" placeholder="Ex: Protocolo de Dosimetria Radiológica em PET-CT"/></h1>
                    </div>
                    <group>
                        <group string="Classificação e Discente">
                            <field name="student_id"/>
                            <field name="thesis_id"/>
                            <field name="type_id"/>
                            <field name="axis_id"/>
                        </group>
                        <group string="Maturidade e Aderência">
                            <field name="trl_level"/>
                            <field name="is_adherent"/>
                            <field name="final_stratum"/>
                            <field name="repository_url" widget="url"/>
                        </group>
                    </group>
                    <group string="Justificativa de Aderência à Linha de Pesquisa (Obrigatória)">
                        <field name="adherence_justif" placeholder="Defenda a aderência e ligação do produto com a Linha de Pesquisa do PPG..."/>
                    </group>
                    <group>
                        <group string="Público-Alvo e Beneficiários">
                            <field name="target_audience"/>
                        </group>
                        <group string="Fomento e Agência">
                            <field name="financing_agency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coautores e Equipe (Quota PI)">
                            <field name="author_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="author_role"/>
                                    <field name="ip_share"/>
                                </list>
                            </field>
                        </page>
                        <page string="Avaliações Qualis Tecnológico">
                            <field name="evaluation_ids">
                                <list editable="bottom">
                                    <field name="evaluator_id"/>
                                    <field name="evaluation_date"/>
                                    <field name="dim_impact"/>
                                    <field name="dim_innovation"/>
                                    <field name="dim_applicability"/>
                                    <field name="dim_complexity"/>
                                    <field name="total_score"/>
                                    <field name="final_stratum"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_capes_ptt_product_search" model="ir.ui.view">
        <field name="name">capes.ptt.product.search</field>
        <field name="model">capes.ptt.product</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Produtos PTT">
                <field name="title"/>
                <field name="student_id"/>
                <field name="type_id"/>
                <filter string="Homologados" name="homologated" domain="[('state', '=', 'homologated')]"/>
                <filter string="Aderência Confirmada" name="adherent" domain="[('is_adherent', '=', True)]"/>
                <filter string="Estrato T1 / T2" name="top_stratum" domain="[('final_stratum', 'in', ('T1', 'T2'))]"/>
                <group>
                    <filter string="Tipologia" name="group_by_type" context="{'group_by': 'type_id'}"/>
                    <filter string="Eixo Estruturante" name="group_by_axis" context="{'group_by': 'axis_id'}"/>
                    <filter string="Nível TRL" name="group_by_trl" context="{'group_by': 'trl_level'}"/>
                    <filter string="Estrato Qualis" name="group_by_stratum" context="{'group_by': 'final_stratum'}"/>
                    <filter string="Situação" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_capes_ptt_product" model="ir.actions.act_window">
        <field name="name">Produtos Técnico-Tecnológicos (PTT)</field>
        <field name="res_model">capes.ptt.product</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_capes_ptt_product_search"/>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_capes_ptt_root"
              name="Produtos PTT / Inovação"
              parent="l10n_br_openeducat_capes_core.menu_op_program_capes_root"
              sequence="45"/>

    <menuitem id="menu_capes_ptt_product"
              name="Produtos PTT"
              parent="menu_capes_ptt_root"
              action="action_capes_ptt_product"
              sequence="10"/>
</odoo>
