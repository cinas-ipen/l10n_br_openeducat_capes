<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_op_curriculum_version_tree" model="ir.ui.view">
        <field name="name">op.curriculum.version.tree</field>
        <field name="model">op.curriculum.version</field>
        <field name="arch" type="xml">
            <list string="Versões Regimentais">
                <field name="name"/>
                <field name="program_id"/>
                <field name="max_months_defense"/>
                <field name="min_credits"/>
                <field name="max_external_credits_percent"/>
                <field name="proficiency_stage"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_op_curriculum_version_form" model="ir.ui.view">
        <field name="name">op.curriculum.version.form</field>
        <field name="model">op.curriculum.version</field>
        <field name="arch" type="xml">
            <form string="Versão Regimental">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex: Regimento IPEN 2024, Regimento CDTN 2026"/></h1>
                    </div>
                    <group>
                        <group string="Identificação e Programa">
                            <field name="program_id"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Prazos Temporais e Cronometria">
                            <field name="max_months_defense"/>
                            <field name="max_extension_days"/>
                            <field name="max_days_post_defense_deposit"/>
                            <field name="presentation_max_minutes"/>
                            <field name="arguing_max_minutes_per_member"/>
                        </group>
                    </group>
                    <group>
                        <group string="Trancamento e Retorno">
                            <field name="max_trancamento_days"/>
                            <field name="block_first_semester_trancamento"/>
                            <field name="retorno_rule"/>
                        </group>
                        <group string="Matriz de Créditos (CAPES / Sucupira / Regimento)">
                            <field name="min_credits"/>
                            <field name="min_subject_credits"/>
                            <field name="thesis_credits"/>
                            <field name="other_mandatory_credits"/>
                            <field name="credit_hour_ratio"/>
                            <field name="max_external_credits_percent"/>
                            <field name="max_external_subject_credits" readonly="1"/>
                            <field name="grading_scale_type"/>
                        </group>
                    </group>
                    <group>
                        <group string="Parâmetros Específicos e PTT">
                            <field name="proficiency_stage"/>
                            <field name="teaching_internship_mode"/>
                            <field name="ptt_validation_mode"/>
                            <field name="defense_location_policy"/>
                        </group>
                    </group>
                    <group>
                        <group string="Governança de Alunos Especiais (Disciplinas Isoladas)">
                            <field name="allow_special_students"/>
                            <field name="max_special_subjects_limit" invisible="not allow_special_students"/>
                            <field name="special_credit_validity_months"/>
                            <field name="special_incorporation_workflow"/>
                            <field name="special_transcript_fail_policy"/>
                        </group>
                        <group string="Governança de Disciplinas Intra-IES vs Extra-IES">
                            <field name="allow_intra_ies_credits"/>
                            <field name="max_intra_ies_credits_percent" invisible="not allow_intra_ies_credits"/>
                            <field name="intra_ies_advisor_approval_required" invisible="not allow_intra_ies_credits"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Disciplinas Obrigatórias">
                            <field name="subject_rule_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="scope"/>
                                    <field name="area_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Regras de Comissões (Bancas)">
                            <field name="committee_rule_ids">
                                <list editable="bottom">
                                    <field name="academic_level"/>
                                    <field name="stage"/>
                                    <field name="min_titular_count"/>
                                    <field name="suplente_mode"/>
                                    <field name="advisor_vote_role"/>
                                    <field name="coadvisor_participation"/>
                                    <field name="external_rule"/>
                                    <field name="allow_non_phd_member"/>
                                    <field name="non_phd_approval_level"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_op_curriculum_version" model="ir.actions.act_window">
        <field name="name">Versões Regimentais</field>
        <field name="res_model">op.curriculum.version</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cadastre a primeira Versão Regimental para o programa!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_op_curriculum_version"
              name="Versões Regimentais"
              parent="l10n_br_openeducat_capes_core.menu_op_program_capes_root"
              action="action_op_curriculum_version"
              sequence="20"/>

    <!-- Student Form Extension in Academic -->
    <record id="view_op_student_form_academic" model="ir.ui.view">
        <field name="name">op.student.form.academic</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="l10n_br_openeducat_capes_core.view_op_student_form_capes"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='student_category']" position="after">
                <field name="curriculum_version_id"/>
            </xpath>
        </field>
    </record>
</odoo>
