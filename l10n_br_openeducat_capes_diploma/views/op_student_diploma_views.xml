<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_diploma_360" model="ir.ui.view">
        <field name="name">op.student.form.diploma.360</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <!-- Botão de Impressão do Histórico Oficial no Cabeçalho -->
            <xpath expr="//header" position="inside">
                <button name="action_print_transcript"
                        type="object"
                        string="Imprimir Histórico Escolar"
                        class="btn-primary"
                        icon="fa-print"/>
            </xpath>

            <!-- Smart Button de Diplomas Digitais -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_diplomas" type="object" class="oe_stat_button" icon="fa-certificate">
                    <field name="diploma_count" widget="statinfo" string="Diplomas"/>
                </button>
            </xpath>

            <!-- Aba de Diploma Digital MEC -->
            <xpath expr="//notebook" position="inside">
                <page string="Diploma Digital MEC" name="diploma_page">
                    <field name="diploma_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="diploma_process_number"/>
                            <field name="thesis_id"/>
                            <field name="graduation_date"/>
                            <field name="emission_format"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
