<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.digital.diploma                        -->
        <!-- =============================================================== -->
        <record id="rule_capes_digital_diploma_portal" model="ir.rule">
            <field name="name">Diplomas Digitais: Discente Titulado (Portal)</field>
            <field name="model_id" ref="model_capes_digital_diploma"/>
            <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_capes_digital_diploma_admin" model="ir.rule">
            <field name="name">Diplomas Digitais: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_digital_diploma"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_capes_digital_diploma_coord_sec" model="ir.rule">
            <field name="name">Diplomas Digitais: Coordenação e Secretaria por Programa</field>
            <field name="model_id" ref="model_capes_digital_diploma"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>
    </data>
</odoo>
