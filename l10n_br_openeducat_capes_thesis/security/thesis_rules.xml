<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- =============================================================== -->
        <!-- REGRAS DE REGISTRO: capes.thesis                                 -->
        <!-- =============================================================== -->
        <record id="rule_capes_thesis_portal" model="ir.rule">
            <field name="name">Trabalhos Finais e Bancas: Discente Autor (Portal)</field>
            <field name="model_id" ref="model_capes_thesis"/>
            <field name="domain_force">['|', ('student_id.partner_id', '=', user.partner_id.id), ('student_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_capes_thesis_admin" model="ir.rule">
            <field name="name">Trabalhos Finais e Bancas: Administrador Central (Global)</field>
            <field name="model_id" ref="model_capes_thesis"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_central_admin'))]"/>
        </record>

        <record id="rule_capes_thesis_coord_sec" model="ir.rule">
            <field name="name">Trabalhos Finais e Bancas: Coordenação e Secretaria</field>
            <field name="model_id" ref="model_capes_thesis"/>
            <field name="domain_force">['|', ('program_id', '=', False), ('program_id', '=', user.current_program_id.id)]</field>
            <field name="groups" eval="[(4, ref('l10n_br_openeducat_capes_core.group_capes_program_secretary')), (4, ref('l10n_br_openeducat_capes_core.group_capes_program_coordinator'))]"/>
        </record>

        <record id="rule_capes_thesis_faculty" model="ir.rule">
            <field name="name">Trabalhos Finais e Bancas: Docentes e Examinadores</field>
            <field name="model_id" ref="model_capes_thesis"/>
            <field name="domain_force">['|', '|', ('committee_ids.member_id', '=', user.partner_id.id), ('student_id.advisor_id.partner_id', '=', user.partner_id.id), ('student_id.coadvisor_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
