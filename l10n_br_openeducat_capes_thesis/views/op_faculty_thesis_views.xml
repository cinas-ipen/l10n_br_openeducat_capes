<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_faculty_form_thesis_360" model="ir.ui.view">
        <field name="name">op.faculty.form.thesis.360</field>
        <field name="model">op.faculty</field>
        <field name="inherit_id" ref="openeducat_core.view_op_faculty_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button de Comissões e Bancas Examinadoras -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_committees" type="object" class="oe_stat_button" icon="fa-users">
                    <field name="committee_count" widget="statinfo" string="Bancas"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
