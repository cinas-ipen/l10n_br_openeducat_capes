<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_capes_thesis_tree" model="ir.ui.view">
        <field name="name">capes.thesis.tree</field>
        <field name="model">capes.thesis</field>
        <field name="arch" type="xml">
            <tree string="Ritos Acadêmicos (Qualificação e Defesas)">
                <field name="defense_date"/>
                <field name="student_id"/>
                <field name="stage"/>
                <field name="doc_type"/>
                <field name="title"/>
                <field name="status" widget="badge"/>
                <field name="repository_url" widget="url"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_capes_thesis_form" model="ir.ui.view">
        <field name="name">capes.thesis.form</field>
        <field name="model">capes.thesis</field>
        <field name="arch" type="xml">
            <form string="Rito Acadêmico (Qualificação / Defesa)">
                <header>
                    <button name="action_schedule_rite" string="Validar e Agendar Rito" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_approve_in_board" string="Aprovar na Banca" type="object" class="oe_highlight" invisible="status != 'scheduled'"/>
                    <button name="action_disapprove_in_board" string="Reprovar na Banca" type="object" class="btn-danger" invisible="status != 'scheduled'"/>
                    <button name="action_homologate_deposit" string="Homologar Depósito DSpace &amp; Titular" type="object" class="oe_highlight" invisible="status != 'deposit_pending'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,scheduled,approved,deposit_pending,homologated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title" string="Título Final Aprovado em Ata"/>
                        <h1><field name="title" placeholder="Ex: Síntese e Caracterização de novos Nanomateriais"/></h1>
                    </div>
                    <group>
                        <group string="Identificação e Vínculo Acadêmico">
                            <field name="student_id"/>
                            <field name="curriculum_version_id"/>
                            <field name="work_plan_id"/>
                            <field name="project_id"/>
                        </group>
                        <group string="Rito e Cronograma">
                            <field name="stage"/>
                            <field name="doc_type"/>
                            <field name="defense_date"/>
                            <field name="presentation_time_minutes"/>
                            <field name="arguing_time_minutes"/>
                        </group>
                    </group>
                    <group string="Repositório Institucional (DSpace / Fonte Ouro)">
                        <group>
                            <field name="repository_url" widget="url"/>
                        </group>
                        <group>
                            <field name="deposit_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comissão Examinadora (Banca)">
                            <field name="committee_ids">
                                <tree editable="bottom">
                                    <field name="member_id"/>
                                    <field name="member_role"/>
                                    <field name="is_titular"/>
                                    <field name="can_vote"/>
                                    <field name="is_internal"/>
                                    <field name="ies_origin"/>
                                    <field name="has_phd"/>
                                    <field name="civil_relationship_flag"/>
                                    <field name="non_phd_approval_doc"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Metadados e Resumos">
                            <group>
                                <group string="Português">
                                    <field name="keywords_main"/>
                                    <field name="abstract_main"/>
                                </group>
                                <group string="Inglês (Abstract)">
                                    <field name="title_alt"/>
                                    <field name="keywords_alt"/>
                                    <field name="abstract_alt"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_capes_thesis_search" model="ir.ui.view">
        <field name="name">capes.thesis.search</field>
        <field name="model">capes.thesis</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Ritos Acadêmicos">
                <field name="title"/>
                <field name="student_id"/>
                <field name="repository_url"/>
                <filter string="Agendados" name="scheduled" domain="[('status', '=', 'scheduled')]"/>
                <filter string="Pendente Depósito DSpace" name="deposit_pending" domain="[('status', '=', 'deposit_pending')]"/>
                <filter string="Homologados / Titulados" name="homologated" domain="[('status', '=', 'homologated')]"/>
                <filter string="Defesas Finais" name="stage_defense" domain="[('stage', '=', 'defense')]"/>
                <filter string="Qualificações" name="stage_qual" domain="[('stage', '=', 'qualification')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Rito" name="group_by_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Situação" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Tipo de Documento" name="group_by_doctype" context="{'group_by': 'doc_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_capes_thesis" model="ir.actions.act_window">
        <field name="name">Ritos Acadêmicos (Qualificação / Defesa)</field>
        <field name="res_model">capes.thesis</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_capes_thesis_search"/>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_capes_thesis_root"
              name="Qualificação e Defesas"
              parent="l10n_br_openeducat_capes_core.menu_op_program_capes_root"
              sequence="40"/>

    <menuitem id="menu_capes_thesis"
              name="Ritos e Bancas"
              parent="menu_capes_thesis_root"
              action="action_capes_thesis"
              sequence="10"/>
</odoo>
