<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_thesis_360" model="ir.ui.view">
        <field name="name">op.student.form.thesis.360</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button de Ritos e Trabalhos de Conclusão -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_theses" type="object" class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="thesis_count" widget="statinfo" string="Ritos/Defesas"/>
                </button>
            </xpath>

            <!-- Aba de Trabalhos de Conclusão e Ritos Acadêmicos -->
            <xpath expr="//notebook" position="inside">
                <page string="Trabalho de Conclusão / Ritos" name="theses_page">
                    <field name="thesis_ids" nolabel="1">
                        <list>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="stage"/>
                            <field name="status"/>
                            <field name="defense_date"/>
                            <field name="secretariat_approval"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
